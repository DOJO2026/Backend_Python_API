{
  "name": "Backend Python API",

  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "forwardPorts": [
    8000
  ],

  "portsAttributes": {
    "8000": {
      "label": "Python API",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "if [ -f requirements.txt ]; then pip install -r requirements.txt; else echo 'No se encontró requirements.txt'; fi"
}